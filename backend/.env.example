DJANGO_SECRET_KEY=change-me-in-railway
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=.railway.app,localhost
DJANGO_TIME_ZONE=Asia/Karachi
DEFAULT_CURRENCY=PKR

# After you create both Railway services, paste real public HTTPS URLs here
CORS_ALLOWED_ORIGINS=https://your-frontend.up.railway.app
CSRF_TRUSTED_ORIGINS=https://your-frontend.up.railway.app

# Postgres — Railway injects this when you add a Postgres plugin
# DATABASE_URL=postgresql://...

# Cloudflare R2 (bucket stores files; Railway DB stores public URLs only)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=am-media
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# CLOUDFLARE_R2_ENDPOINT=
